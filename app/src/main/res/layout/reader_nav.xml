<?xml version="1.0" encoding="utf-8"?>
<!-- The page / chapter / auto-scroll bar: a vertical pill on the right edge.
     Top to bottom: next chapter, last page number, slider (fills bottom to top),
     current page number, previous chapter, play (auto scroll). -->
<eu.kanade.tachiyomi.ui.reader.ReaderNavView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reader_nav"
    android:background="@drawable/chapter_nav"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="top"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="ltr">

    <ImageButton
        android:id="@+id/right_chapter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/next_chapter"
        android:padding="@dimen/material_layout_keylines_screen_edge_margin"
        android:rotation="270"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/right_page_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:tint="?actionBarTintColor"
        app:srcCompat="@drawable/ic_skip_next_24" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/right_progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="16dp"
        app:trackThickness="3dp"
        app:layout_constraintTop_toTopOf="@id/right_chapter"
        app:layout_constraintBottom_toBottomOf="@id/right_chapter"
        app:layout_constraintStart_toStartOf="@id/right_chapter"
        app:layout_constraintEnd_toEndOf="@id/right_chapter" />

    <TextView
        android:id="@+id/right_page_text"
        android:layout_width="32sp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?actionBarTintColor"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/right_chapter"
        app:layout_constraintBottom_toTopOf="@id/reader_seekbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="15" />

    <eu.kanade.tachiyomi.ui.reader.ReaderVerticalSliderLayout
        android:id="@+id/reader_seekbar"
        android:layout_width="40dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/right_page_text"
        app:layout_constraintBottom_toTopOf="@id/left_page_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <eu.kanade.tachiyomi.ui.reader.ReaderSlider
            android:id="@+id/page_seekbar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:stepSize="1"
            app:labelBehavior="gone"
            tools:value="4"
            tools:valueTo="10"
            tools:ignore="SpeakableTextPresentCheck" />

    </eu.kanade.tachiyomi.ui.reader.ReaderVerticalSliderLayout>

    <TextView
        android:id="@+id/left_page_text"
        android:layout_width="32sp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?actionBarTintColor"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/reader_seekbar"
        app:layout_constraintBottom_toTopOf="@id/left_chapter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1-2" />

    <ImageButton
        android:id="@+id/left_chapter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/previous_chapter"
        android:padding="@dimen/material_layout_keylines_screen_edge_margin"
        android:rotation="270"
        app:layout_constraintTop_toBottomOf="@id/left_page_text"
        app:layout_constraintBottom_toTopOf="@id/auto_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="?actionBarTintColor"
        app:srcCompat="@drawable/ic_skip_previous_24" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/left_progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorSize="16dp"
        app:trackThickness="3dp"
        app:layout_constraintTop_toTopOf="@id/left_chapter"
        app:layout_constraintBottom_toBottomOf="@id/left_chapter"
        app:layout_constraintStart_toStartOf="@id/left_chapter"
        app:layout_constraintEnd_toEndOf="@id/left_chapter" />

    <ImageButton
        android:id="@+id/auto_scroll"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="تمرير تلقائي"
        android:padding="@dimen/material_layout_keylines_screen_edge_margin"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/left_chapter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="?actionBarTintColor"
        app:srcCompat="@drawable/ic_play_arrow_24dp" />

</eu.kanade.tachiyomi.ui.reader.ReaderNavView>
