<?xml version="1.0" encoding="utf-8"?>
<eu.kanade.tachiyomi.ui.reader.settings.ReaderGeneralView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/filter_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:background="@drawable/bottom_sheet_rounded_background"
    android:forceDarkAllowed="false">

    <LinearLayout
        android:id="@+id/constraint_layout"
        style="@style/BottomSheetDialogTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/material_component_dialogs_padding_around_content_area"
        android:paddingTop="0dp"
        android:paddingEnd="@dimen/material_component_dialogs_padding_around_content_area"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_reader_webtoon_24dp"
                    app:tint="?attr/colorSecondary" />

                <com.google.android.material.textview.MaterialTextView
                    style="?textAppearanceTitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="15sp"
                    android:text="@string/series" />
            </LinearLayout>

            <eu.kanade.tachiyomi.widget.MaterialSpinnerView
                android:id="@+id/viewer_series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:entries="@array/viewers_selector"
                app:title="@string/reading_mode" />
            <eu.kanade.tachiyomi.widget.MaterialSpinnerView
                android:id="@+id/rotation_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:entries="@array/rotation_type"
                app:title="@string/orientation" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brightness_day_24dp"
                    app:tint="?attr/colorSecondary" />

                <com.google.android.material.textview.MaterialTextView
                    style="?textAppearanceTitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="15sp"
                    android:text="@string/general" />
            </LinearLayout>

            <eu.kanade.tachiyomi.widget.MaterialSpinnerView
                android:id="@+id/background_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:title="@string/background_color" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/show_page_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/show_page_number"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/fullscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fullscreen"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/cutout_short"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pref_cutout_short"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/keepscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/keep_screen_on"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/always_show_chapter_transition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/always_show_chapter_transition"
                android:textColor="?attr/colorOnBackground" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tune_24dp"
                    app:tint="?attr/colorSecondary" />

                <com.google.android.material.textview.MaterialTextView
                    style="?textAppearanceTitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="15sp"
                    android:text="الأدوات والشريط" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                style="?textAppearanceBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorOnBackground"
                android:text="إخفاء الأدوات تلقائيًا" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/r_autohide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/r_clock_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="الساعة والبطارية في الركن"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/r_progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="شريط تقدم دائم في الأسفل"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/r_volume_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="أزرار الصوت تقلّب الصفحات"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/r_volume_inverted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="عكس اتجاه أزرار الصوت"
                android:textColor="?attr/colorOnBackground" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_swap_vert_24dp"
                    app:tint="?attr/colorSecondary" />

                <com.google.android.material.textview.MaterialTextView
                    style="?textAppearanceTitleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="15sp"
                    android:text="التمرير بلمس أسفل الشاشة (ويبتون)" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/r_tap_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="التمرير بلمس أسفل الشاشة"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.textview.MaterialTextView
                style="?textAppearanceBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorOnBackground"
                android:text="جهتا التمرير" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/r_tap_side"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
            <com.google.android.material.textview.MaterialTextView
                style="?textAppearanceBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorOnBackground"
                android:text="مقدار القفز" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/r_tap_jump"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/r_hold_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="الضغط المطوّل للتمرير المستمر"
                android:textColor="?attr/colorOnBackground" />
            <com.google.android.material.textview.MaterialTextView
                style="?textAppearanceBodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorOnBackground"
                android:text="سرعة الضغط المطوّل" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/r_hold_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</eu.kanade.tachiyomi.ui.reader.settings.ReaderGeneralView>
